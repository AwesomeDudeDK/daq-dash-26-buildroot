#!/bin/sh

DAEMON=/opt/dash/dash
PIDFILE=/var/run/dash.pid

start() {
	printf "Starting dash: "
	cd /opt/dash || exit 1
	start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" && echo "OK" || echo "FAIL"
}

stop() {
	printf "Stopping dash: "
	start-stop-daemon -K -p "$PIDFILE" && echo "OK" || echo "FAIL"
	rm -f "$PIDFILE"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart) stop; sleep 1; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
